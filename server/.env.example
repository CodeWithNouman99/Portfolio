PORT=5000
CLIENT_URL=http://localhost:5173

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Latest stable Flash model (Oct 2026). Leave empty to use this default.
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried once if the main model is overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional but recommended: Groq answers the chat when Gemini is rate-limited or down.
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# Fast production model on Groq (Oct 2026). Check which models your key can use at
# https://console.groq.com/docs/models (Llama models may not be available on every account).
GROQ_MODEL=openai/gpt-oss-20b

# Optional: MongoDB connection string (e.g. Atlas). Leads are saved to the "leads" collection.
MONGODB_URI=
# Optional: n8n webhook that receives each lead as JSON.
N8N_WEBHOOK_URL=

# Optional: set to 1 when deployed behind one proxy (Render, Railway, Vercel) so rate limits see real IPs.
TRUST_PROXY=0
